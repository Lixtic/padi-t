# Copy these into Vercel: Project Settings > Environment Variables.
# Set ONE provider key. With no key, the app runs in demo mode with a sample layout.

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Only needed if you set more than one key (anthropic | openai | gemini)
# LLM_PROVIDER=anthropic

# Optional model overrides
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-4.1
# GEMINI_MODEL=gemini-2.5-flash

# Output budget for one answer. A full package needs about 6000-9000 tokens.
# MAX_OUTPUT_TOKENS=8000

# Optional: require teachers to enter this code before generating (protects your API spend)
# ACCESS_CODE=

# Generations per IP per 10 minutes (default 8). With DATABASE_URL this is shared across instances.
# RATE_LIMIT=8

# Daily token budget for each teacher (or each network address when not signed in). Default 200000.
# Each uncached request reserves estimated input plus its full output-token ceiling before calling the AI.
# Set 0 to turn the per-subject limit off. The day runs 00:00-24:00 UTC.
# TOKEN_QUOTA_DAILY=200000
# Optional site-wide daily token cap, a brake on your total AI spend. Default 0 (off).
# TOKEN_CAP_DAILY_GLOBAL=0
# For cross-instance quota/rate-limit enforcement, set DATABASE_URL. If configured but unavailable,
# generation is blocked rather than bypassing the protection. Without it, enforcement is best-effort per instance.

# Saved answers: a repeat of a recent request is served at no token cost. Needs DATABASE_URL to be shared
# between serverless instances (without it, each instance keeps its own short list).
# CACHE_TTL_DAYS=30           # how long an answer is kept
# CACHE_SIMILARITY=0.8        # how alike teacher's notes must be (0 to 1) to reuse an answer
# CACHE_DISABLED=1            # turn the cache off

# Optional account sync and live updates through Neon.
# DATABASE_URL=
# NEON_AUTH_BASE_URL=
# NEON_AUTH_JWKS_URL=
# NEON_REALTIME_URL=
# NEON_REALTIME_SECRET=
# AUTH_SECRET=
# SMTP_URL=
# MAIL_FROM=GuidEd <no-reply@example.com>

# ── Tiers: guest preview, Free and Pro ─────────────────────────────────────────────────────────────
# Active whenever accounts are set up. Set TIERS=off to give everyone the full product with no limits.
# TIERS=off
# GUEST_PREVIEWS_DAILY=3        Lesson-1 tasters a visitor without an account may start per day (repeats from the shared cache are free)
# PREVIEW_MAX_TOKENS=2200       Output cap for a taster
# FREE_PLANS_WEEKLY=10          Full plans per week for a signed-in free teacher (0 = unlimited)
# FREE_CLASSES=3               Classes a free teacher may plan for in a week (0 = all)
# PRO_TOKEN_QUOTA_DAILY=600000  Daily spending guard for Pro teachers (free and guests use TOKEN_QUOTA_DAILY)
# PRO_PRICE_MONTHLY=23          Cedis. PRO_DAYS_MONTHLY=30
# PRO_PRICE_TERM=50             Cedis. PRO_DAYS_TERM=120
# PRO_CURRENCY=GHS
# PRO_EMAILS=you@example.com    Always Pro (staff, testers). Comma separated.
# PAYSTACK_SECRET_KEY=sk_live_...   Turns payments on. Also set the webhook (see README).

# Who can open the Feedback inbox in the app menu (bug reports and suggestions). Comma separated sign-in emails.
# ADMIN_EMAILS=you@example.com

# Pro-ending reminder emails. Vercel Cron calls /api/billing?action=reminders once a day (see vercel.json).
# CRON_SECRET=any-long-random-text    Required, or the reminder job refuses to run. Vercel sends it automatically.
# SMTP_URL=smtp://user:pass@host:587  Mail server (the same one used for sign-in codes). MAIL_FROM sets the sender.
# REMIND_DAYS=3                       How many days before Pro ends to send the email.

# Ads on the Free plan (leave empty for no ads). One AdSense banner on the start screen for Guest and Free teachers only.
ADSENSE_CLIENT=
ADSENSE_SLOT=
# ADS_PERSONALIZED=1 allows personalised ads; the default asks Google for non-personalised ads.

# ── Rewarded video: a free teacher who has used the week's plans may watch one short video for one more plan ──
# REWARDED_ADS=gam                       Off when empty. 'gam' = Google Ad Manager rewarded ads (needs the unit below). 'test' = a plain countdown with no ad, for testing only.
# ADMANAGER_REWARDED_UNIT=/1234567/guided_rewarded   Your Ad Manager "Out-of-page: Rewarded" ad unit path (network code, then unit name).
# REWARD_PER_DAY=2                       Videos that count, per teacher per day.
# REWARD_PLANS=1                         Bonus plans each video earns.
# REWARD_MIN_SECONDS=6                   The least time a video can take before it counts (10 in test mode).

# The address used in email links and logos (defaults to https://www.guidedgh.site)
# SITE_URL=https://www.guidedgh.site

# Optional fallback image providers. Add keys/tokens in Vercel to enable each provider.
# PIXABAY_API_KEY=
# PEXELS_API_KEY=
# FLICKR_API_KEY=
# OPENVERSE_ACCESS_TOKEN=  # Optional; anonymous Openverse access works without a token
