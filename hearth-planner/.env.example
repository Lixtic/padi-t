# Copy these into Vercel: Project Settings > Environment Variables.
# Set ONE provider key. With no key, the app runs in demo mode with a sample layout.

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Only needed if you set more than one key (anthropic | openai | gemini)
# LLM_PROVIDER=anthropic

# Optional model overrides
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-4.1
# GEMINI_MODEL=gemini-2.5-flash

# Output budget for one answer. A full package needs about 6000-9000 tokens.
# MAX_OUTPUT_TOKENS=8000

# Optional: require teachers to enter this code before generating (protects your API spend)
# ACCESS_CODE=

# Optional: generations per IP per 10 minutes (default 8)
# RATE_LIMIT=8

# Optional account sync and live updates through Neon.
# DATABASE_URL=
# NEON_AUTH_BASE_URL=
# NEON_AUTH_JWKS_URL=
# NEON_REALTIME_URL=
# NEON_REALTIME_SECRET=
# AUTH_SECRET=
# SMTP_URL=
# MAIL_FROM=Padi-T <no-reply@example.com>
