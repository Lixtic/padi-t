{
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/generate.js": {
      "maxDuration": 300
    },
    "api/export_docx.py": {
      "includeFiles": "lib/**",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/((?!migrate\\.html$).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data: blob: https://upload.wikimedia.org https://thumb.wikimedia.org https://i.ytimg.com https://cdn.pixabay.com https://pixabay.com https://images.pexels.com https://live.staticflickr.com https://*.staticflickr.com https://api.openverse.org https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://*.gstatic.com https://*.adtrafficquality.google; style-src 'self'; style-src-attr 'unsafe-inline'; script-src 'self' https://*.googletagservices.com https://*.googleadservices.com https://securepubads.g.doubleclick.net https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.adtrafficquality.google https://*.doubleclick.net https://www.googletagservices.com; connect-src 'self' https://*.neon.tech https://*.neon.com wss://*.neon.tech wss://*.neon.com https://upload.wikimedia.org https://thumb.wikimedia.org https://cdn.pixabay.com https://pixabay.com https://images.pexels.com https://live.staticflickr.com https://*.staticflickr.com https://api.openverse.org https://pagead2.googlesyndication.com https://*.adtrafficquality.google https://*.google.com https://*.doubleclick.net; frame-src https://www.guidedgh.site https://googleads.g.doubleclick.net https://*.googlesyndication.com https://*.doubleclick.net https://*.adtrafficquality.google; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/migrate.html",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; frame-ancestors https://app.guidedgh.site"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "app.guidedgh.site"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/billing?action=reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/billing?action=family-reminders",
      "schedule": "0 17 * * 0"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(www\\.guidedgh\\.site|guidedgh\\.site)"
        }
      ],
      "destination": "/home.html"
    },
    {
      "source": "/",
      "destination": "/app.html"
    },
    {
      "source": "/parents",
      "destination": "/app.html"
    },
    {
      "source": "/teachers",
      "destination": "/app.html"
    },
    {
      "source": "/news",
      "destination": "/api/sync?what=news"
    },
    {
      "source": "/news/:slug",
      "destination": "/api/sync?what=news&slug=:slug"
    },
    {
      "source": "/news-sitemap.xml",
      "destination": "/api/sync?what=news-sitemap"
    },
    {
      "source": "/api/export-docx",
      "destination": "/api/export_docx"
    },
    {
      "source": "/api/account-profile",
      "destination": "/api/sync?what=account-profile"
    },
    {
      "source": "/api/neon-webhook",
      "destination": "/api/neon-auth?path=__webhook"
    },
    {
      "source": "/api/neon-auth/:path*",
      "destination": "/api/neon-auth?path=:path*"
    }
  ],
  "redirects": [
    {
      "source": "/parents",
      "has": [
        {
          "type": "host",
          "value": "(www\\.guidedgh\\.site|guidedgh\\.site)"
        }
      ],
      "destination": "https://app.guidedgh.site/parents",
      "permanent": false
    },
    {
      "source": "/teachers",
      "has": [
        {
          "type": "host",
          "value": "(www\\.guidedgh\\.site|guidedgh\\.site)"
        }
      ],
      "destination": "https://app.guidedgh.site/teachers",
      "permanent": false
    },
    {
      "source": "/admin",
      "has": [
        {
          "type": "host",
          "value": "(www\\.guidedgh\\.site|guidedgh\\.site)"
        }
      ],
      "destination": "https://app.guidedgh.site/admin",
      "permanent": false
    },
    {
      "source": "/product",
      "destination": "https://www.guidedgh.site/",
      "permanent": true
    },
    {
      "source": "/(app|app.html)",
      "has": [
        {
          "type": "host",
          "value": "(www\\.guidedgh\\.site|guidedgh\\.site)"
        }
      ],
      "destination": "https://app.guidedgh.site/",
      "permanent": false
    }
  ]
}
